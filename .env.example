# Runtime config — injected into window.__LYRA_CONFIG__ via nginx envsubst at container startup.
# Copy to .env in the lyra/ app directory and fill in values.

# AI Chat
LYRA_AI_PROTOCOL=openai
LYRA_AI_BASE_URL=https://api.openai.com/v1
LYRA_AI_MODEL=gpt-4o
LYRA_AI_API_KEY=
LYRA_AI_MAX_TOKENS=4096

# Backend (optional — enables cloud sync)
DATABASE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lyra-files
S3_REGION=garage
